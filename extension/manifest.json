{
  "manifest_version": 3,
  "name": "New API Codex OAuth 助手",
  "short_name": "New API OAuth",
  "version": "2.0.0",
  "minimum_chrome_version": "109",
  "description": "通过 OAuth PKCE 授权或导入 auth.json，导出 New API Codex 渠道凭证，保留真实 refresh_token。",
  "permissions": [
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://auth.openai.com/*"
  ],
  "action": {
    "default_title": "打开 New API OAuth 助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
